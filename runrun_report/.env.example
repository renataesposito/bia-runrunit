APP_KEY=SUA_APP_KEY_AQUI
USER_TOKEN=SEU_USER_TOKEN_AQUI
CLOUDFLARE_TUNNEL_TOKEN=SEU_TOKEN_DO_TUNNEL_AQUI

# Debug mode - habilita botão de debug no header (true/false)
DEBUG_MODE_ENABLED=false

# Buscar todas as tarefas (não apenas closed=True) - útil para Debug (true/false)
FETCH_ALL_TASKS=false

# SQLite database path (opcional, padrão: data/nuclea.db)
SQLITE_DB_PATH=data/nuclea.db

# Emails permitidos para sobrescrever a data do comentário (separados por vírgula)
ALLOWED_DATE_OVERRIDE_EMAILS=user1@email.com,user2@email.com

